# Samrudhi Agentic OS — Environment Configuration
# Copy to .env and fill in. All services run locally.

# --- Server ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Ollama (local LLM) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=300

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=samrudhi
POSTGRES_USER=samrudhi_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://samrudhi_app:change-me@localhost:5432/samrudhi

# --- Redis (bus + queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Tenant (demo) ---
DEFAULT_TENANT_ID=DEMO-HEALTHCARE-01
